# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# AI providers — agents are routed through the central router in lib/agents/llm.ts
# Chain per agent: primary model -> backup providers -> local Ollama.
# Free tiers:
#   Gemini  https://aistudio.google.com/apikey      (gemini-2.5-flash, -flash-lite)
#   Groq    https://console.groq.com/keys           (llama-3.3-70b-versatile, llama-3.1-8b-instant)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# Optional: OpenAI (paid) — Lead + Developer primary per default assignment.
# OPENAI_API_KEY=your-openai-key

# Optional: Anthropic (paid) — Interviewer/Designer primary + backups.
# ANTHROPIC_API_KEY=your-anthropic-key

# Optional: Devin delegation for the Developer Agent (paid service — opt-in).
# DEVIN_API_KEY=your-devin-key
# DEVIN_DELEGATE=true
# DEVIN_MAX_WAIT_MS=600000

# Optional: per-agent model assignment, format "provider:model".
# Providers: openai | gemini | groq | anthropic | ollama
# MODEL_LEAD_PRIMARY=openai:gpt-6.1-sol
# MODEL_LEAD_FALLBACK=anthropic:claude-opus-5-5
# MODEL_FAST_PRIMARY=gemini:gemini-3.5-flash-lite
# MODEL_FAST_FALLBACK=anthropic:claude-haiku-5-5
# MODEL_INTERVIEWER_PRIMARY=anthropic:claude-sonnet-5-5
# MODEL_INTERVIEWER_FALLBACK=openai:gpt-6.1-sol
# MODEL_DESIGNER_PRIMARY=anthropic:claude-opus-5-5
# MODEL_DESIGNER_FALLBACK=gemini:gemini-3.5-flash
# MODEL_DEVELOPER_PRIMARY=openai:gpt-6-sol
# MODEL_DEVELOPER_FALLBACK=anthropic:claude-sonnet-5-5

# Optional: local Ollama last-resort fallback. Defaults shown.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
